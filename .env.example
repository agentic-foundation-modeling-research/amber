# Required
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional, use if evaluating Anthropic models
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Required by environment_setup/webarena/setup.sh
# Container registry holding the prebuilt WebArena images, e.g.
# us-central1-docker.pkg.dev/<project>/webarena-prebuilt-images
WEBARENA_IMAGE_REGISTRY=
WEBARENA_IMAGE_TAG=latest
# Bucket holding the OpenStreetMap website archive and the Wikipedia .zim file,
# e.g. gs://webarena-eval-assets
WEBARENA_ASSETS_BUCKET=

# Required by the vm_utils/ scripts that create and sync the GCP VMs
GCP_PROJECT_ID=
GCP_ZONE=us-central1-f
# Subnet for the VM network interface. "default" is correct for a personal GCP
# project, which gets an auto-mode "default" VPC with a subnet in every region.
# Shared-VPC setups need their own subnet name here.
GCP_SUBNET=default
# Reach the VMs through Google's Identity-Aware Proxy tunnel. Required when the
# VMs have no external IP. Set to false if your VMs have an external IP (the
# default on a personal project) and you have not configured IAP.
GCP_USE_IAP=true
